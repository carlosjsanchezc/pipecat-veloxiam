# Copia a .env y rellena los valores. NO lo subas con secretos reales.

# --- Cuentas de voz ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.5          # fallback si /call/start no lo trae
# nova-2-phonecall solo es/en — con language=es Deepgram da HTTP 400.
DEEPGRAM_MODEL=nova-3             # WhatsApp y Telnyx, si /call/start no trae deepgramModel
# Idioma solo del STT. `multi` = Deepgram detecta español/inglés/etc. por frase (requiere nova-3).
# Vacío = usa el idioma de la llamada (language / DEFAULT_LANGUAGE).
DEEPGRAM_LANGUAGE=multi
# Con multi, la respuesta (Cartesia + campo `language` a Veloxiam) sigue el idioma
# que detecta Deepgram, solo entre estos idiomas.
REPLY_LANGUAGES=es,en
# Palabras mínimas en el idioma nuevo para cambiar ("ok"/"yes" sueltos no cambian).
LANGUAGE_SWITCH_MIN_WORDS=2
# Añade " RESPONDE EN EL IDIOMA <idioma>" al texto enviado a Veloxiam. false = texto tal cual.
REPLY_LANGUAGE_HINT=true

# Idioma (TTS, y STT si DEEPGRAM_LANGUAGE está vacío) si Veloxiam no envía `language`.
DEFAULT_LANGUAGE=es

# --- Agente Veloxiam ---
# Endpoint LLM (URL fija); el bot se identifica por header x-bot-id.
LLM_RESPONSE_URL=https://api.veloxiam.com/api/v1/agent-voice/llm-response
# Tras la despedida TTS ("te transfiero"), Pipecat POSTea aquí para que Veloxiam
# ejecute el transfer (ahí empieza el ring). Si se omite, se deriva reemplazando
# llm-response → transfer-execute en LLM_RESPONSE_URL.
# TRANSFER_EXECUTE_URL=https://api.veloxiam.com/api/v1/agent-voice/transfer-execute
TRANSCRIPT_URL=                 # opcional: volcado del transcript al terminar

# --- Límites ---
MAX_SESSIONS=10

# --- Tiempos de voz (segundos) ---
GREETING_DELAY_SEC=1.0             # WhatsApp/WebRTC: espera tras conectar antes del saludo TTS
TELNYX_GREETING_DELAY_SEC=0.5     # Telnyx: idem
USER_TURN_STOP_TIMEOUT_SEC=5.0    # Fallback si Smart Turn no cierra el turno
GREETING_MAX_SEC=45               # Fallback: habilita barge-in si el saludo no termina
RELEASE_MAX_SEC=15                # Fallback: libera pipeline si no llega fin de TTS tras transfer/end_call
TTS_PREBUFFER_MS=250              # Audio de Cartesia acumulado antes de empezar a sonar (absorbe entregas tardías; 0 = desactivado)
AUDIO_CLIP_MAX_SEC=300            # Duración máxima reproducida de un audiofile de Veloxiam
REPLY_HOLD_GRACE_SEC=1.0          # Si hubo voz/ruido mientras se esperaba a Veloxiam: margen sin turno nuevo antes de hablar
REPLY_HOLD_MAX_SEC=15             # Tope de esa retención

# --- Smart Turn v3.2 (fin de turno, bundled Pipecat) + Silero (VAD/barge-in) ---
SMART_TURN_CPU_COUNT=1

# Silero WhatsApp (opcional; defaults en pipeline/vad.py)
# WHATSAPP_VAD_CONFIDENCE=0.7
# WHATSAPP_VAD_START_SECS=0.2
# WHATSAPP_VAD_MIN_VOLUME=0.6

# Silero Telnyx PSTN (opcional)
# TELNYX_VAD_CONFIDENCE=0.65
# TELNYX_VAD_START_SECS=0.15
# TELNYX_VAD_MIN_VOLUME=0.35

# --- Telnyx (telefonía PSTN, WS /telnyx) ---
# OPCIONAL: solo para que Pipecat cuelgue la llamada en Telnyx al terminar el
# pipeline. Sin esto Telnyx cuelga igual cuando el llamante corta. El bot/voz
# llegan por la query del WS desde Veloxiam (no se configuran aquí).
TELNYX_API_KEY=

# --- WebRTC ---
STUN_SERVER=stun:stun.l.google.com:19302
# TURN opcional (NAT estricto):
# TURN_SERVER=turn:tu-turn:3478
# TURN_USERNAME=
# TURN_PASSWORD=
