# Copia a .env y rellena los valores. NO lo subas con secretos reales.

# --- Servicios de voz ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # voice_id de Cartesia con soporte español (requerido)
CARTESIA_MODEL=sonic-2
DEEPGRAM_MODEL=nova-2-general
GREETING_TEXT=              # saludo opcional al conectar la llamada

# --- Agente NestJS (Veloxiam) ---
NESTJS_AGENT_URL=https://api.veloxiam.com/api/v1/bots/voice-calls

# --- Límites / bot por defecto ---
MAX_SESSIONS=10
DEFAULT_BOT_ID=
DEFAULT_TENANT_ID=

# --- WhatsApp Cloud API (Calling) ---
WHATSAPP_TOKEN=                          # access token de la Graph API
WHATSAPP_PHONE_NUMBER_ID=                # phone_number_id del número de negocio
WHATSAPP_APP_SECRET=                     # app secret (valida firma del webhook)
WHATSAPP_WEBHOOK_VERIFICATION_TOKEN=     # token de verificación del webhook
