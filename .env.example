# Copia a .env y rellena los valores. NO lo subas con secretos reales.

# --- Cuentas de voz ---
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3.5          # fallback si /call/start no lo trae
DEEPGRAM_MODEL=nova-2-phonecall   # fallback si /call/start no lo trae

# --- Agente Veloxiam ---
# Endpoint LLM (URL fija); el bot se identifica por header x-bot-id.
LLM_RESPONSE_URL=https://api.veloxiam.com/api/v1/agent-voice/llm-response
TRANSCRIPT_URL=                 # opcional: volcado del transcript al terminar

# --- Límites ---
MAX_SESSIONS=10

# --- Tiempos de voz (segundos) ---
GREETING_DELAY_SEC=1.0             # WhatsApp/WebRTC: espera tras conectar antes del saludo TTS
TELNYX_GREETING_DELAY_SEC=0.5     # Telnyx: idem
USER_TURN_STOP_TIMEOUT_SEC=5.0    # Fallback si Smart Turn no cierra el turno
GREETING_MAX_SEC=45               # Fallback: habilita barge-in si el saludo no termina
RELEASE_MAX_SEC=30                # Fallback: libera pipeline si no llega fin de TTS tras transfer/end_call

# --- Smart Turn v3.2 (fin de turno, bundled Pipecat) + Silero (VAD/barge-in) ---
SMART_TURN_CPU_COUNT=1

# Silero WhatsApp (opcional; defaults en pipeline/vad.py)
# WHATSAPP_VAD_CONFIDENCE=0.7
# WHATSAPP_VAD_START_SECS=0.2
# WHATSAPP_VAD_MIN_VOLUME=0.6

# Silero Telnyx PSTN (opcional)
# TELNYX_VAD_CONFIDENCE=0.65
# TELNYX_VAD_START_SECS=0.15
# TELNYX_VAD_MIN_VOLUME=0.35

# --- Telnyx (telefonía PSTN, WS /telnyx) ---
# OPCIONAL: solo para que Pipecat cuelgue la llamada en Telnyx al terminar el
# pipeline. Sin esto Telnyx cuelga igual cuando el llamante corta. El bot/voz
# llegan por la query del WS desde Veloxiam (no se configuran aquí).
TELNYX_API_KEY=

# --- WebRTC ---
STUN_SERVER=stun:stun.l.google.com:19302
# TURN opcional (NAT estricto):
# TURN_SERVER=turn:tu-turn:3478
# TURN_USERNAME=
# TURN_PASSWORD=
